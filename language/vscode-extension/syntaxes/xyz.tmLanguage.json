{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "xyz",
  "scopeName": "source.xyz",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#keywords" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.xyz", "match": "//.*$" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.xyz",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.xyz", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.xyz",
          "begin": "'",
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.xyz", "match": "\\\\." }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.xyz", "match": "\\b\\d+(?:\\.\\d+)?\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.xyz", "match": "(?:\\+=|-=|\\*=|/=|%=|==|!=|<=|>=|[+\\-*/%<>=])" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "support.function.xyz", "match": "\\b(print|input|int|float|string|bool|range|execute|__init)\\b(?=\\s*\\()" },
        { "name": "variable.language.xyz", "match": "\\bself\\b" },
        { "name": "storage.type.xyz", "match": "\\b(var|int|float|string|bool|list|any)\\b" },
        { "name": "keyword.control.xyz", "match": "\\b(if|else|try|catch|for|in|while|repeat|times|break|continue|return|import|class|func|and|or|not)\\b" },
        { "name": "constant.language.xyz", "match": "\\b(true|false|null)\\b" }
      ]
    }
  }
}
