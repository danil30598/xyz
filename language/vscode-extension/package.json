{
  "name": "xyz",
  "displayName": "xyz",
  "description": "Поддержка экспериментального языка xyz",
  "version": "0.0.45",
  "publisher": "xyz",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Programming Languages"],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:xyz",
    "onCommand:xyz.runFile",
    "onCommand:xyz.buildFile",
    "onCommand:xyz.installPackage"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "xyz",
        "aliases": ["xyz", "XYZ"],
        "extensions": [".xyz"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "xyz",
        "scopeName": "source.xyz",
        "path": "./syntaxes/xyz.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "xyz.runFile",
        "title": "xyz: Запустить текущий файл",
        "icon": "$(play)"
      },
      {
        "command": "xyz.installPackage",
        "title": "xyz: Установить пакет"
      },
      {
        "command": "xyz.buildFile",
        "title": "xyz: Собрать переносимую программу",
        "icon": "$(package)"
      }
    ],
    "keybindings": [
      {
        "command": "xyz.runFile",
        "key": "f6",
        "when": "editorLangId == xyz"
      }
    ],
    "problemMatchers": [
      {
        "name": "xyz",
        "owner": "xyz",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^(.*):(\\d+):(\\d+):\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      }
    ],
    "configurationDefaults": {
      "[xyz]": {
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.tabCompletion": "on",
        "editor.snippetSuggestions": "top"
      }
    },
    "configuration": {
      "title": "xyz",
      "properties": {
        "xyz.registryUrl": {
          "type": "string",
          "default": "",
          "description": "URL JSON-реестра пакетов xyz. Также можно указать поле registry в xyz.json."
        }
      }
    },
    "menus": {
      "editor/title": [
        {
          "command": "xyz.runFile",
          "when": "editorLangId == xyz",
          "group": "navigation"
        },
        {
          "command": "xyz.buildFile",
          "when": "editorLangId == xyz",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "test": "node ./test/run-tests.js"
  },
  "license": "MIT"
}
